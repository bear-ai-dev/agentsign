{
  "name": "@bear-ai-dev/agentcontract",
  "version": "0.1.15",
  "description": "Agent-native contract sending CLI and signing API for marketplace onboarding.",
  "private": false,
  "type": "module",
  "bin": {
    "agentcontract": "dist/src/cli.js",
    "agentsign": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "migrations",
    "src/templates",
    "README.md",
    "SKILLS.md",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bear-ai-dev/agentsign.git"
  },
  "keywords": [
    "contracts",
    "esign",
    "cli",
    "marketplace",
    "onboarding",
    "agents"
  ],
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "cli": "tsx src/cli.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run test && npm run build",
    "build": "npm run font:embed && node scripts/clean-dist.mjs && tsc && node scripts/copy-assets.mjs",
    "start": "node dist/src/index.js",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:status": "tsx scripts/migrate.ts --status",
    "migrate:dry-run": "tsx scripts/migrate.ts --dry-run",
    "feedback:autopilot": "tsx scripts/feedback-autopilot.ts",
    "font:embed": "node scripts/embed-signature-font.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@sparticuz/chromium": "^148.0.0",
    "@workos-inc/node": "^8.8.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "hono": "^4.6.16",
    "marked": "^15.0.6",
    "nanoid": "^5.0.9",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "posthog-node": "^5.36.2",
    "puppeteer-core": "^25.8.0",
    "sanitize-html": "^2.17.5"
  },
  "devDependencies": {
    "@fontsource/allura": "5.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.0",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  }
}
